<Project>
    <!-- Engine-specific properties. Content should not use this file. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>nullable;CS8785</WarningsAsErrors>
    </PropertyGroup>
    <Import Project="Robust.Engine.Version.props" />
    <ItemGroup>
        <PackageVersion Include="Microsoft.Testing.Extensions.Retry" Version="2.3.3" />
    </ItemGroup>
</Project>
